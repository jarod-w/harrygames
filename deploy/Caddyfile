# Prototype: plain HTTP on :80 (port 443 on this server is already used by another service).
# For the real launch: point a domain here and let Caddy fetch HTTPS automatically (needed for PWA).
:80 {
	root * /srv
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
